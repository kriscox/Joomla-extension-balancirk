{
  "name": "balancirk-spa",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first Angular PWA for Balancirk (members, teachers, accounting)",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "deploy:joomla": "node scripts/deploy-to-joomla.mjs",
    "build:deploy": "npm run build:prod && npm run deploy:joomla"
  },
  "dependencies": {
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/router": "21.2.18",
    "@angular/service-worker": "21.2.18",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.18",
    "typescript": "~5.9.3"
  }
}
