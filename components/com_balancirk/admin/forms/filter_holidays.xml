<?xml version="1.0" encoding="utf-8"?>
<form>

    <fields name="filter">

        <field name="search"
            type="text"
            label="COM_BALANCIRK_FILTER_SEARCH_LABEL"
            description="COM_BALANCIRK_FILTER_SEARCH_HOLIDAYS_DESC"
            hint="JSEARCH_FILTER" />

    </fields>

    <fields name="list">

        <field name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.startDate ASC"
            onchange="this.form.submit();">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.year ASC">COM_BALANCIRK_HOLIDAYS_SORT_YEAR_ASC</option>
            <option value="a.year DESC">COM_BALANCIRK_HOLIDAYS_SORT_YEAR_DESC</option>
            <option value="a.startDate ASC">COM_BALANCIRK_HOLIDAYS_SORT_START_ASC</option>
            <option value="a.startDate DESC">COM_BALANCIRK_HOLIDAYS_SORT_START_DESC</option>
            <option value="a.endDate ASC">COM_BALANCIRK_HOLIDAYS_SORT_END_ASC</option>
            <option value="a.endDate DESC">COM_BALANCIRK_HOLIDAYS_SORT_END_DESC</option>
            <option value="a.summary ASC">COM_BALANCIRK_HOLIDAYS_SORT_SUMMARY_ASC</option>
            <option value="a.summary DESC">COM_BALANCIRK_HOLIDAYS_SORT_SUMMARY_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            onchange="this.form.submit();" />
    </fields>
</form>
